# The MCP process should receive these through the Codex MCP configuration
# or its parent environment. Never commit real values.
UNIVERSAL_MCP_PROJECT_ROOT=/absolute/path/to/your/project
UNIVERSAL_MCP_CONFIG=/absolute/path/to/universal-mcp/workers.json
UNIVERSAL_MCP_STORAGE_PATH=/absolute/path/to/your/project/.universal-mcp-state.sqlite3
UNIVERSAL_MCP_HTTP_TOKEN=replace-with-a-long-random-secret
ANTIGRAVITY_MAX_PROMPT_BYTES=120000

# Use the public base URL from the Kaggle deployment. It may end in /v1;
# the bridge adds /chat/completions and /models automatically.
KAGGLE_QWEN_BASE_URL=https://your-kaggle-public-url.example
KAGGLE_QWEN_API_KEY=replace-with-your-key

# Required only when using the command transport for Antigravity.
ANTIGRAVITY_WORKER_COMMAND=python3 /absolute/path/to/antigravity_worker_adapter.py
