#!/usr/bin/env python3
"""Dev entry point for the siphon terminal-native TUI (no pip install needed)."""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(_here))

from siphon.term.app import run  # noqa: E402

if __name__ == "__main__":
    run()
