#!/usr/bin/env python3
"""Dev entry point for siphon-studio (no pip install needed)."""

import os
import sys

# `siphon` may be symlinked onto PATH (e.g. ~/.local/bin/siphon), so resolve
# the real location of this script to find the source checkout to import from.
_here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(_here))

from siphon.cli.main import entry  # noqa: E402

if __name__ == "__main__":
    entry()