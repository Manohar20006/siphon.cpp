# Default local server configuration for Qwen3-Coder-Next (qwen3next arch).
# 48 layers / 512 experts / 10 used. Unlike Qwen3.6 there is no MTP head, so
# speculative decoding (--spec-type draft-mtp) is disabled here.

MODEL=/home/manohar/Downloads/Qwen3-Coder-Next-Q4_K_M.gguf
# Coder-Next (qwen3next arch, 48L/512 experts) has no matching expert suite
# (the -8192.txt suite is for the 41L/256-exp qwen35moe models), so the static
# pinned expert file is left unset/disabled here.
EXPERTS=
ALIAS=qwen3-coder-next
HOST=127.0.0.1
PORT=8090

CTX=65536
export LLAMA_DSTORAGE_PREFILL_WORKSPACE=0
export LLAMA_DSTORAGE_PREFILL_WORKSPACE_LOOKAHEAD=2
BATCH=512
UBATCH=128

MOE_GPU_CACHE_MIB=2816
MOE_PINNED_CACHE_MIB=4096
CACHE_RAM_MIB=2048
GDS_READ_THREADS=20

# Keep the pinned cache warm during decode (see qwen3.6 config notes).
# Do NOT set LLAMA_MOE_PINNED_PREFILL_ONLY=1: it frees the pinned cache after
# prefill, forcing every decode step to reload hot experts from NVMe.

# Empty static expert suite + evict-to-RAM: no pre-pinned experts; instead the
# pinned cache is filled on VRAM eviction (warm experts copied host-side), so
# a later decode miss is served from RAM instead of re-reading from NVMe.
export LLAMA_DSTORAGE_EVICT_TO_RAM=1

# No MTP tensors in this model -> speculation left off.
SPEC_DRAFT_N_MAX=0

CHECKPOINT_MIN_STEP=0
export LLAMA_ARG_CTX_CHECKPOINTS=12

# Leave empty to use the model's embedded chat template.
CHAT_TEMPLATE=
CHAT_TEMPLATE_KWARGS='{"preserve_thinking": true}'
REASONING=off
REASONING_FORMAT=deepseek
REASONING_BUDGET=0

# KV-shift cache reuse disabled (hybrid model reports it unsupported).
CACHE_REUSE=0

# Expose /metrics for cache and latency checks.
METRICS=1