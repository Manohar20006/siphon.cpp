# KAT-Coder-V2.5-Dev-MTP (qwen35moe arch, 41 layers / 256 experts / 8 used).
# Has real MTP (nextn) tensors -> use --spec-type draft-mtp for speculation.
#
# UD-IQ4_XS quant: token_embd/Q8_0, lm_head/Q6_K, experts IQ4_XS+IQ3_S.

MODEL=/home/manohar/Downloads/Kwaipilot_KAT-Coder-V2.5-Dev-MTP-UD-IQ4_XS.gguf
EXPERTS=expert-suites/moe-static-experts-suite-8192.txt
ALIAS=kat-coder-mtp
HOST=127.0.0.1
PORT=8090

CTX=86016
export LLAMA_DSTORAGE_PREFILL_WORKSPACE=0
export LLAMA_DSTORAGE_PREFILL_WORKSPACE_LOOKAHEAD=2
BATCH=512
UBATCH=128

MOE_GPU_CACHE_MIB=2500
MOE_PINNED_CACHE_MIB=8192
CACHE_RAM_MIB=4096
GDS_READ_THREADS=20

# 2.5 GB VRAM L1 expert cache + 8 GB L2 pinned RAM cache.
# Evict-to-RAM: keep LRU-evicted experts pinned host-side instead of re-reading
# them from NVMe on the next decode miss.
export LLAMA_DSTORAGE_EVICT_TO_RAM=1

# Model has real MTP tensors -> native multi-token-prediction speculation.
SPEC_TYPE=draft-mtp

CHECKPOINT_MIN_STEP=0
export LLAMA_ARG_CTX_CHECKPOINTS=12

CHAT_TEMPLATE=
CHAT_TEMPLATE_KWARGS='{"preserve_thinking": true}'
REASONING=off
REASONING_FORMAT=deepseek
REASONING_BUDGET=0

CACHE_REUSE=0
METRICS=1
CACHE_PROMPT=0